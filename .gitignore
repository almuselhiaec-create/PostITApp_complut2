# Ignore node_modules folders anywhere
node_modules/

# Ignore all environment variable files
.env*

# Ignore npm/yarn debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore MacOS system files
.DS_Store

# Optional: ignore build folders if you have them
/dist/
/build/

# Optional: ignore coverage reports
/coverage/
